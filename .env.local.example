# 캠페인 혜택 가입 링크 (UTM 포함)
NEXT_PUBLIC_SIGNUP_URL=https://gemini.google.com/students
# 무료 Google Analytics(GA4) 측정 ID. 실제 G-... 값 설정 후 재배포 필요.
# 가입 버튼 클릭은 signup_click 이벤트로 수집 (Vercel 유료 플랜 불필요).
NEXT_PUBLIC_GA_ID=G-XXXXXXX

# 배포 도메인. og:image 절대 URL 생성에 쓰인다.
# 없으면 Vercel 프로덕션 URL, 그것도 없으면 localhost 로 떨어진다.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# 플레이그라운드 프롬프트 저장용 Google Apps Script 웹앱 (apps-script/Code.gs)
PLAYGROUND_WEBHOOK_URL=https://script.google.com/macros/s/XXXX/exec
PLAYGROUND_SHARED_SECRET=change-me-to-a-long-random-string

# 프롬프트 찾기 AI (서버 전용, NEXT_PUBLIC_ 접두사 사용 금지)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
