# 응모 데이터를 받을 Apps Script 웹앱 URL (서버 전용, 절대 NEXT_PUBLIC_ 금지)
ENTRY_WEBHOOK_URL=https://script.google.com/macros/s/XXXX/exec
# Route Handler <-> Apps Script 공유 비밀키. 아무 긴 랜덤 문자열
ENTRY_SHARED_SECRET=change-me-to-a-long-random-string

# 캠페인 혜택 가입 링크 (UTM 포함)
NEXT_PUBLIC_SIGNUP_URL=https://gemini.google.com/students
# GA4 측정 ID
NEXT_PUBLIC_GA_ID=G-XXXXXXX

# 배포 도메인. og:image 절대 URL 생성에 쓰인다.
# 없으면 Vercel 프로덕션 URL, 그것도 없으면 localhost 로 떨어진다.
NEXT_PUBLIC_SITE_URL=https://your-domain.example
